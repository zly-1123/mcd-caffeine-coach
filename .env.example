# 复制为 .env 后填入你自己的值。.env 已被 .gitignore 忽略，不会进入版本库。
# 严禁把真实 Token 写进 mcp-config.example.json 或任何随仓库提交的文件。
MCD_MCP_TOKEN=YOUR_MCP_TOKEN

# 可选：MCP Server 地址（默认即为官方地址）
MCD_MCP_URL=https://mcp.mcd.cn

# 可选：默认门店编码（不填则从历史订单自动推断）
# MCD_STORE_CODE=

# 可选：默认就寝时间与咖啡因阈值（用于"几点前必须喝完"计算）
# MCD_BEDTIME=23:30
# MCD_SLEEP_CAFFEINE_THRESHOLD_MG=30
