{
  "schema_version": "1.0.0",
  "model_name": "McCafe Caffeine Estimate Model",
  "units": {
    "caffeine": "mg",
    "time": "hour"
  },
  "disclaimer": "麦当劳中国 MCP 官方数据不包含咖啡因字段（list-nutrition-foods 仅提供能量/蛋白/脂肪/碳水/钠/钙）。本模型的咖啡因数值基于公开的萃取参考值换算得出，属于可复核的估算，不是麦当劳官方数据。所有数值集中在本文件，使用者可自行覆盖；脚本不会把估算值伪装成官方数据。",
  "pharmacokinetics": {
    "half_life_hours": 5.0,
    "half_life_range_hours": [3.0, 7.0],
    "half_life_note": "健康成人咖啡因消除半衰期中位约 5 小时，个体差异主要来自 CYP1A2 酶活性、吸烟、口服避孕药等因素，公开区间约 3-7 小时。本模型不使用体重线性外推，因为咖啡因清除率与体重没有稳定比例关系。",
    "daily_budget_mg": 400,
    "pregnancy_budget_mg": 200,
    "daily_budget_note": "非孕健康成人每日 400mg 是广泛采用的参考上限。",
    "sleep_threshold_mg": 30,
    "sleep_threshold_note": "就寝时体内残余低于该值时，对入睡的影响通常可忽略；调低该值会得到更保守的结论。"
  },
  "size_aliases": {
    "迷你": "迷你",
    "迷你杯": "迷你",
    "小": "小",
    "小杯": "小",
    "中": "中",
    "中杯": "中",
    "大": "大",
    "大杯": "大"
  },
  "rules": [
    {
      "id": "cola_zero",
      "match": "无糖可口可乐|无糖可乐",
      "size_mg": { "默认": 40 },
      "basis": "无糖可乐的咖啡因与常规可乐一致，按中杯 400ml 折算。"
    },
    {
      "id": "cola",
      "match": "可乐",
      "size_mg": { "小": 28, "中": 40, "大": 55, "默认": 40 },
      "basis": "可乐咖啡因约 10mg/100ml，小/中/大杯按 280/400/550ml 折算。"
    },
    {
      "id": "espresso",
      "match": "浓缩咖啡",
      "size_mg": { "默认": 63 },
      "basis": "1 份意式浓缩（约 30ml）按 63mg 计。"
    },
    {
      "id": "brew_coffee",
      "match": "鲜萃咖啡|滴滤咖啡",
      "size_mg": { "小": 95, "大": 140, "默认": 95 },
      "basis": "滴滤咖啡按 240ml 约 95mg、360ml 约 140mg 折算。"
    },
    {
      "id": "americano",
      "match": "美式",
      "size_mg": { "小": 63, "中": 126, "大": 189, "默认": 126 },
      "basis": "美式按 小1/中2/大3 份浓缩折算，每份 63mg。"
    },
    {
      "id": "latte_oat",
      "match": "燕麦奶铁",
      "size_mg": { "小": 63, "中": 126, "大": 126, "默认": 126 },
      "basis": "奶铁按 小1/中2/大2 份浓缩折算；燕麦奶不改变咖啡因含量。"
    },
    {
      "id": "latte",
      "match": "奶铁|拿铁",
      "size_mg": { "小": 63, "中": 126, "大": 126, "默认": 126 },
      "basis": "奶铁按 小1/中2/大2 份浓缩折算，每份 63mg。"
    },
    {
      "id": "cappuccino",
      "match": "卡布奇诺",
      "size_mg": { "中": 126, "大": 189, "默认": 126 },
      "basis": "卡布奇诺按 中2/大3 份浓缩折算。"
    },
    {
      "id": "macchiato",
      "match": "玛奇朵",
      "size_mg": { "小": 63, "中": 126, "默认": 126 },
      "basis": "焦糖玛奇朵按 1-2 份浓缩折算。"
    },
    {
      "id": "affogato_coffee",
      "match": "咖啡阿芙佳朵",
      "size_mg": { "默认": 63 },
      "basis": "咖啡阿芙佳朵含 1 份浓缩。"
    },
    {
      "id": "affogato_matcha",
      "match": "抹茶阿芙佳朵",
      "size_mg": { "默认": 25 },
      "basis": "抹茶粉本身含咖啡因，单份按 25mg 估算。"
    },
    {
      "id": "matcha_latte",
      "match": "抹茶牛奶|浓浓抹茶",
      "size_mg": { "中": 40, "大": 55, "默认": 40 },
      "basis": "抹茶牛奶的咖啡因全部来自抹茶粉，中杯按 40mg 估算。"
    },
    {
      "id": "dark_chocolate",
      "match": "浓浓燕麦黑巧|浓浓黑巧|黑巧克力",
      "size_mg": { "中": 12, "大": 16, "默认": 12 },
      "basis": "可可基底饮品，咖啡因只来自可可固形物，中杯按 12mg 估算。"
    },
    {
      "id": "hot_chocolate",
      "match": "朱古力|热巧",
      "size_mg": { "默认": 12 },
      "basis": "可可基底饮品，按 12mg 估算。"
    },
    {
      "id": "oat_milk",
      "match": "燕麦奶",
      "size_mg": { "默认": 0 },
      "basis": "纯植物奶，不含咖啡因。"
    },
    {
      "id": "milk",
      "match": "牛奶|奶昔",
      "size_mg": { "默认": 0 },
      "basis": "乳制品，不含咖啡因。"
    },
    {
      "id": "soy_milk",
      "match": "豆浆",
      "size_mg": { "默认": 0 },
      "basis": "豆浆不含咖啡因。"
    },
    {
      "id": "lemon_tea",
      "match": "柠檬红茶",
      "size_mg": { "小": 30, "中": 40, "大": 50, "默认": 40 },
      "basis": "柠檬红茶按红茶底浓度折算，中杯 40mg。"
    },
    {
      "id": "black_tea",
      "match": "伯爵红茶|锡兰红茶|红茶",
      "size_mg": { "默认": 47 },
      "basis": "红茶按 240ml 约 47mg 折算。"
    },
    {
      "id": "zero_caffeine",
      "match": "雪碧|怡泉|纯悦|苹果汁|黄金橙橙|多汁柠柠|麦炫酷|阳光橙|爆珠|奶冻|新地|麦旋风|冰淇淋",
      "size_mg": { "默认": 0 },
      "basis": "碳酸饮料、果汁、水、冰淇淋类，不含咖啡因。"
    }
  ]
}
